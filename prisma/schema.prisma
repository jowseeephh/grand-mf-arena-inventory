generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STORE
}

enum OrderStatus {
  PENDING
  APPROVED
  PREPARING
  RELEASED
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  RECEIVE
  SALE
  ADJUSTMENT
}

enum EventStatus {
  ACTIVE
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id])
  createdAt    DateTime @default(now())

  stockMovements StockMovement[]
  remittances    Remittance[]
  activityLogs   ActivityLog[]
  orders         Order[]

  @@index([storeId])
}

model Store {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. SUGBABS
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users       User[]
  orders      Order[]
  sales       Sale[]
  remittances Remittance[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id           String   @id @default(cuid())
  name         String
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  unit         String   @default("pc")
  costPrice    Decimal  @db.Decimal(12, 2)
  sellingPrice Decimal  @db.Decimal(12, 2)
  currentStock Int      @default(0)
  minStock     Int      @default(0)
  imageUrl     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItems     OrderItem[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([categoryId])
}

model Event {
  id          String      @id @default(cuid())
  name        String
  eventDate   DateTime
  description String?
  status      EventStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())

  orders         Order[]
  sales          Sale[]
  stockMovements StockMovement[]
  remittances    Remittance[]
}

model Order {
  id                String      @id @default(cuid())
  orderNo           Int         @unique @default(autoincrement())
  eventId           String
  event             Event       @relation(fields: [eventId], references: [id])
  storeId           String
  store             Store       @relation(fields: [storeId], references: [id])
  placedById        String?
  placedBy          User?       @relation(fields: [placedById], references: [id])
  status            OrderStatus @default(PENDING)
  notes             String?
  // Guard so inventory is deducted and the sale recorded exactly once.
  inventoryDeducted Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items OrderItem[]
  sale  Sale?

  @@index([eventId, storeId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  // Price snapshot at time of ordering
  unitCost  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
}

model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  eventId       String?
  event         Event?            @relation(fields: [eventId], references: [id])
  type          StockMovementType
  quantity      Int // positive = in, negative = out
  previousStock Int
  newStock      Int
  orderId       String?
  note          String?
  createdById   String?
  createdBy     User?             @relation(fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([eventId])
}

model Sale {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id])
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  totalCost  Decimal  @db.Decimal(14, 2)
  totalSales Decimal  @db.Decimal(14, 2)
  profit     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())

  items SaleItem[]

  @@index([eventId, storeId])
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal @db.Decimal(12, 2)
  unitPrice  Decimal @db.Decimal(12, 2)
  totalCost  Decimal @db.Decimal(14, 2)
  totalSales Decimal @db.Decimal(14, 2)
  profit     Decimal @db.Decimal(14, 2)

  @@index([saleId])
  @@index([productId])
}

model Remittance {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id])
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  amount       Decimal  @db.Decimal(14, 2)
  remittedAt   DateTime @default(now())
  reference    String?
  note         String?
  recordedById String?
  recordedBy   User?    @relation(fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([eventId, storeId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
